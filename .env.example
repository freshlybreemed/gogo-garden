# MongoDB connection string (database "music"; collections bands/music/user)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/music

# Firebase web config (auth). apiKey is the value previously stored as
# REACT_APP_VERCEL_FIREBASE_API_KEY in Vercel.
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=garden-fe26e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=garden-fe26e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=garden-fe26e.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=835999403649
NEXT_PUBLIC_FIREBASE_APP_ID=1:835999403649:web:801da0f4b0f23ced0a8780
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-FSGERJTR9V

# Supabase (Project Settings → API / Database). Replaces Mongo + Firebase once migrated.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Server only — bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>
# Postgres connection string, used by the one-time migration script.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Audio + images stay on S3 (public read).
NEXT_PUBLIC_MEDIA_BASE_URL=https://gogogarden191046-dev.s3.amazonaws.com
